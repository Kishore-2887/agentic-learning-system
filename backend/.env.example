# Environment Configuration
# Supported providers: "mock", "openai", "google"
LLM_PROVIDER=mock

# OpenAI API Key (optional if using mock or google)
OPENAI_API_KEY=

# Google Gemini API Key (optional if using mock or openai)
GEMINI_API_KEY=

# Model Names
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-pro

# Agent Workflow Settings
DEFAULT_QUALITY_THRESHOLD=80.0
MAX_IMPROVEMENT_ATTEMPTS=3

# Database
DATABASE_URL=sqlite:///./learning_agent.db

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

